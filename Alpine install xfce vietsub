#!/data/data/com.termux/files/usr/bin/bash

set -e

GREEN='\033[0;32m'
BLUE='\033[0;34m'
NC='\033[0m'

echo -e "${BLUE}=== Alpine Linux XFCE Installer ===${NC}"

echo -e "${GREEN}[1/6] Updating and installing required packages...${NC}"
pkg update -y && pkg upgrade -y
pkg install -y proot-distro wget curl

echo -e "${GREEN}[2/6] Installing Alpine Linux...${NC}"
proot-distro install alpine

echo -e "${GREEN}[3/6] Configuring Alpine Linux...${NC}"
cat > /data/data/com.termux/files/usr/var/lib/proot-distro/installed-rootfs/alpine/root/setup.sh << 'EOF'
#!/bin/sh

echo "nameserver 8.8.8.8" > /etc/resolv.conf
apk update
apk upgrade

apk add xfce4 xfce4-terminal xfce4-screensaver lightdm-gtk-greeter dbus

apk add tigervnc xvfb

apk add chromium

apk add font-noto font-noto-cjk ttf-dejavu

mkdir -p ~/.vnc

echo "123456" | vncpasswd -f > ~/.vnc/passwd
chmod 600 ~/.vnc/passwd

cat > ~/.vnc/xstartup << 'VNCEOF'
#!/bin/sh
unset SESSION_MANAGER
unset DBUS_SESSION_BUS_ADDRESS
export XKL_XMODMAP_DISABLE=1
export XDG_RUNTIME_DIR=/tmp/runtime-root
mkdir -p $XDG_RUNTIME_DIR
chmod 700 $XDG_RUNTIME_DIR
dbus-launch --exit-with-session startxfce4 &
VNCEOF

chmod +x ~/.vnc/xstartup

cat > /usr/local/bin/startvnc << 'STARTEOF'
#!/bin/sh
export USER=root
export HOME=/root
export XDG_RUNTIME_DIR=/tmp/runtime-root
mkdir -p $XDG_RUNTIME_DIR
chmod 700 $XDG_RUNTIME_DIR

vncserver -kill :1 2>/dev/null || true

vncserver :1 -geometry 1280x720 -depth 24 -localhost no

echo "================================"
echo "VNC Server started!"
echo "Address: localhost:5901"
echo "Password: 123456"
echo "================================"
echo "Use VNC Viewer to connect"
echo "To stop VNC: vncserver -kill :1"
STARTEOF

chmod +x /usr/local/bin/startvnc

echo "Installation completed!"
EOF

chmod +x /data/data/com.termux/files/usr/var/lib/proot-distro/installed-rootfs/alpine/root/setup.sh

echo -e "${GREEN}[4/6] Installing XFCE, VNC and Chromium...${NC}"
proot-distro login alpine -- /root/setup.sh

echo -e "${GREEN}[5/6] Creating startup commands...${NC}"
cat > $PREFIX/bin/alpine << 'ALPINEEOF'
#!/data/data/com.termux/files/usr/bin/bash
proot-distro login alpine
ALPINEEOF

cat > $PREFIX/bin/alpine-vnc << 'VNCSTARTEOF'
#!/data/data/com.termux/files/usr/bin/bash
proot-distro login alpine -- startvnc
VNCSTARTEOF

chmod +x $PREFIX/bin/alpine
chmod +x $PREFIX/bin/alpine-vnc

echo -e "${GREEN}[6/6] Starting VNC Server...${NC}"
alpine-vnc

echo ""
echo -e "${BLUE}================================${NC}"
echo -e "${GREEN}Installation completed!${NC}"
echo -e "${BLUE}================================${NC}"
echo ""
echo "Usage:"
echo "1. Start Alpine: alpine"
echo "2. Start VNC: alpine-vnc"
echo ""
echo "VNC Info:"
echo "  - Address: localhost:5901"
echo "  - Password: 123456"
echo ""
echo "Install VNC Viewer on your device:"
echo "  https://play.google.com/store/apps/details?id=com.realvnc.viewer.android"
echo ""
echo -e "${BLUE}================================${NC}"
